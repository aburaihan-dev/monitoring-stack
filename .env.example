# ── Grafana ───────────────────────────────────────────────────────────────────
GRAFANA_VERSION=13.1.0
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme_strong_password

# ── Service Versions ─────────────────────────────────────────────────────────
ALLOY_VERSION=v1.17.1
LOKI_VERSION=3.7.3
TEMPO_VERSION=3.0.2
MIMIR_VERSION=3.1.2
ALERTMANAGER_VERSION=v0.33.1
NODE_EXPORTER_VERSION=v1.12.1
CADVISOR_VERSION=0.60.5
BLACKBOX_VERSION=v0.28.0
VALKEY_VERSION=9.1.0-alpine3.23

# ── Object Storage — choose ONE backend ──────────────────────────────────────
# OBJECT_STORAGE: garage (default) | seaweedfs — set via: ./stack storage <mode>
# The OBJECT_STORAGE_* values below are managed automatically by that command
# (copied from GARAGE_* or SEAWEEDFS_* below) — do not set them by hand.
OBJECT_STORAGE=garage
OBJECT_STORAGE_ENDPOINT=garage:3900
OBJECT_STORAGE_ACCESS_KEY_ID=GKchangeme0000000000000000000000
OBJECT_STORAGE_SECRET_ACCESS_KEY=changeme_openssl_rand_hex_32
OBJECT_STORAGE_REGION=garage

# ── Garage (S3-compatible object storage — default backend) ─────────────────
# GARAGE_RPC_SECRET: generate with:  openssl rand -hex 32
# GARAGE_ADMIN_TOKEN: generate with: openssl rand -hex 16
# GARAGE_ACCESS_KEY_ID: must start with "GK" followed by hex chars
# GARAGE_SECRET_ACCESS_KEY: generate with: openssl rand -hex 32
# GARAGE_CAPACITY_GB: layout capacity hint — set to your available disk space
GARAGE_VERSION=v2.3.0
GARAGE_RPC_SECRET=changeme_openssl_rand_hex_32
GARAGE_ADMIN_TOKEN=changeme_openssl_rand_hex_16
GARAGE_ACCESS_KEY_ID=GKchangeme0000000000000000000000
GARAGE_SECRET_ACCESS_KEY=changeme_openssl_rand_hex_32
GARAGE_CAPACITY_GB=100

# ── SeaweedFS (S3-compatible object storage — alternative backend) ──────────
# SEAWEEDFS_ACCESS_KEY_ID / SECRET: static S3 credentials for the embedded gateway
SEAWEEDFS_VERSION=4.39
SEAWEEDFS_ACCESS_KEY_ID=SWchangeme0000000000000000000000
SEAWEEDFS_SECRET_ACCESS_KEY=changeme_openssl_rand_hex_32

# ── Alertmanager — Slack ──────────────────────────────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/REPLACE/WITH/YOUR_WEBHOOK
SLACK_CHANNEL=#monitoring-alerts

# ── Alertmanager — Email ─────────────────────────────────────────────────────
ALERT_EMAIL_FROM=alerts@example.com
ALERT_EMAIL_TO=oncall@example.com
SMTP_HOST=smtp.example.com:587
SMTP_USERNAME=alerts@example.com
SMTP_PASSWORD=changeme

# ── Retention (edit and run: ./stack recreate loki / mimir / tempo) ──────────
LOKI_RETENTION_PERIOD=180d
TEMPO_RETENTION_PERIOD=4320h
MIMIR_RETENTION_PERIOD=180d

# ── Reverse proxy (optional — front Grafana with nginx) ──────────────────────
# PROXY_MODE: none (direct host ports, default) | http (nginx, no TLS) |
#             ssl (nginx, terminates TLS using your existing cert/key)
# Set via:  ./stack proxy <none|http|ssl>
PROXY_MODE=none
PROXY_HTTP_PORT=80
PROXY_HTTPS_PORT=443
# COMPOSE_PROFILES is managed automatically by `./stack proxy`/`./stack storage`
# — do not set by hand. Must always include the active OBJECT_STORAGE backend.
COMPOSE_PROFILES=garage
