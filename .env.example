# ── Domain ───────────────────────────────────────────────────────────────────
# All services are available as subdomains of BASE_DOMAIN.
# Add these to /etc/hosts (or your DNS) pointing to the host IP:
#   grafana.monitoring.local
#   alertmanager.monitoring.local
#   uar.monitoring.local
#   s3.monitoring.local
#   alloy.monitoring.local
#   ingest.monitoring.local
BASE_DOMAIN=monitoring.local

# ── Grafana ───────────────────────────────────────────────────────────────────
GRAFANA_VERSION=13.0.1
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme_strong_password

# ── Service Versions ─────────────────────────────────────────────────────────
ALLOY_VERSION=v1.16.1
LOKI_VERSION=3.7.1
TEMPO_VERSION=2.10.5
MIMIR_VERSION=3.0.6
ALERTMANAGER_VERSION=v0.32.1
NODE_EXPORTER_VERSION=v1.11.1
CADVISOR_VERSION=v0.56.2
BLACKBOX_VERSION=v0.28.0
REDIS_VERSION=8-alpine

# ── Garage (S3-compatible object storage — replaces MinIO) ───────────────────
# GARAGE_RPC_SECRET: generate with:  openssl rand -hex 32
# GARAGE_ADMIN_TOKEN: generate with: openssl rand -hex 16
# GARAGE_ACCESS_KEY_ID: must start with "GK" followed by hex chars
# GARAGE_SECRET_ACCESS_KEY: generate with: openssl rand -hex 32
GARAGE_VERSION=v2.3.0
GARAGE_RPC_SECRET=changeme_openssl_rand_hex_32
GARAGE_ADMIN_TOKEN=changeme_openssl_rand_hex_16
GARAGE_ACCESS_KEY_ID=GKchangeme0000000000000000000000
GARAGE_SECRET_ACCESS_KEY=changeme_openssl_rand_hex_32

# ── Alertmanager — Slack ──────────────────────────────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/REPLACE/WITH/YOUR_WEBHOOK
SLACK_CHANNEL=#monitoring-alerts

# ── Alertmanager — Email ─────────────────────────────────────────────────────
ALERT_EMAIL_FROM=alerts@example.com
ALERT_EMAIL_TO=oncall@example.com
SMTP_HOST=smtp.example.com:587
SMTP_USERNAME=alerts@example.com
SMTP_PASSWORD=changeme

# ── Retention (edit and run: make restart svc=loki / mimir / tempo) ──────────
LOKI_RETENTION_PERIOD=30d
TEMPO_RETENTION_PERIOD=336h
MIMIR_RETENTION_PERIOD=90d
