{
  "id": null,
  "uid": "loki-host-logs",
  "title": "Host Logs",
  "description": "System logs from the host machine: syslog, auth, kernel, systemd journal",
  "tags": ["loki", "logs", "host"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "templating": {
    "list": [
      {
        "name": "job",
        "label": "Log Source",
        "type": "query",
        "datasource": { "type": "loki", "uid": "loki" },
        "query": "label_values(job)",
        "current": {},
        "refresh": 2,
        "includeAll": true,
        "allValue": ".+",
        "multi": false,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Syslog",
      "type": "logs",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 0 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": {
        "dedupStrategy": "none",
        "showLabels": false,
        "showCommonLabels": true,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "expr": "{job=\"syslog\"}",
          "refId": "A",
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 2,
      "title": "Auth Log",
      "type": "logs",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": {
        "dedupStrategy": "none",
        "showLabels": false,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "expr": "{job=\"auth\"}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Kernel Log",
      "type": "logs",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": {
        "dedupStrategy": "none",
        "showLabels": false,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "expr": "{job=\"kernel\"}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Systemd Journal",
      "type": "logs",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 18 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": {
        "dedupStrategy": "none",
        "showLabels": false,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "expr": "{job=\"systemd-journal\"}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Log Rate by Source",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 28 },
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "lineWidth": 2 }
        }
      },
      "targets": [
        {
          "expr": "sum by (job) (rate({host=\"monitoring-host\"}[5m]))",
          "refId": "A",
          "legendFormat": "{{job}}"
        }
      ]
    }
  ]
}
