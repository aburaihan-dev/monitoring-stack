# Alloy — HTTPS for UI + OTLP HTTP ingest on separate subdomain

# Alloy UI (admin console)
server {
    listen 443 ssl;
    server_name alloy.${BASE_DOMAIN};
    http2 on;

    include /etc/nginx/snippets/ssl-params.conf;
    include /etc/nginx/snippets/security-headers.conf;

    location / {
        include /etc/nginx/snippets/basic-auth.conf;
        include /etc/nginx/snippets/proxy-headers.conf;
        proxy_pass  http://alloy:12345;
    }
}

# Ingest endpoint — OTLP HTTP (4318), Loki push (3500), Prom remote_write (9090)
# Apps within the monitoring network should use alloy:4317/4318 directly (no TLS needed)
# External apps (outside Docker) use these HTTPS endpoints
server {
    listen 443 ssl;
    server_name ingest.${BASE_DOMAIN};
    http2 on;

    include /etc/nginx/snippets/ssl-params.conf;

    # OTLP HTTP traces/metrics/logs  →  /v1/traces  /v1/metrics  /v1/logs
    location /v1/ {
        limit_req zone=api burst=200 nodelay;
        include /etc/nginx/snippets/proxy-headers.conf;
        proxy_pass  http://alloy:4318;
        client_max_body_size 32m;
    }

    # Loki push API  →  /loki/api/v1/push
    location /loki/ {
        limit_req zone=api burst=200 nodelay;
        include /etc/nginx/snippets/proxy-headers.conf;
        proxy_pass  http://alloy:3500;
        client_max_body_size 32m;
    }

    # Prometheus remote_write  →  /api/v1/write
    location /api/v1/write {
        limit_req zone=api burst=200 nodelay;
        include /etc/nginx/snippets/proxy-headers.conf;
        proxy_pass  http://alloy:9090;
        client_max_body_size 32m;
    }
}
