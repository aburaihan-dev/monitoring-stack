# Grafana — HTTPS with WebSocket support (Grafana Live)

server {
    listen 443 ssl;
    server_name grafana.${BASE_DOMAIN};
    http2 on;

    include /etc/nginx/snippets/ssl-params.conf;
    include /etc/nginx/snippets/security-headers.conf;

    # WebSocket upgrade map
    set ${DOLLAR}upgrade_header "";
    if (${DOLLAR}http_upgrade = "websocket") {
        set ${DOLLAR}upgrade_header "upgrade";
    }

    location / {
        include     /etc/nginx/snippets/proxy-headers.conf;
        proxy_pass  http://grafana:3000;

        # WebSocket (Grafana Live — streaming dashboards)
        proxy_set_header  Upgrade    ${DOLLAR}http_upgrade;
        proxy_set_header  Connection ${DOLLAR}upgrade_header;
    }
}
