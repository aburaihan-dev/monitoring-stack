# Garage S3 API — exposed via nginx for external tools (rclone, Cyberduck, s3cmd)
# No web console: Garage has no built-in UI.
# Use an S3 client pointed at https://s3.${BASE_DOMAIN} with:
#   Access Key: GARAGE_ACCESS_KEY_ID
#   Secret Key: GARAGE_SECRET_ACCESS_KEY
#   Region: garage  (path-style addressing required)

server {
    listen 443 ssl;
    server_name s3.${BASE_DOMAIN};
    http2 on;

    include /etc/nginx/snippets/ssl-params.conf;
    include /etc/nginx/snippets/security-headers.conf;

    client_max_body_size 5g;
    proxy_read_timeout   600s;

    location / {
        include /etc/nginx/snippets/proxy-headers.conf;
        proxy_pass  http://garage:3900;
        client_max_body_size 5g;
    }
}
