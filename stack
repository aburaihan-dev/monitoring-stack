  require_env
  local domain
  domain="$(env_val BASE_DOMAIN)"
  local url="https://grafana.${domain}"
  info "Opening ${url}…"
  xdg-open "${url}" 2>/dev/null || open "${url}" 2>/dev/null || \
    warn "Could not open browser automatically — visit: ${url}"
}

cmd_urls() {
  require_env
  local domain
  domain="$(env_val BASE_DOMAIN)"
  echo
  echo -e "${BOLD}  Service URLs${RESET}"
  printf "  ${CYAN}%-18s${RESET} %s\n" "Grafana"      "https://grafana.${domain}"
  printf "  ${CYAN}%-18s${RESET} %s\n" "Alertmanager" "https://alertmanager.${domain}"
  printf "  ${CYAN}%-18s${RESET} %s\n" "Alloy UI"     "https://alloy.${domain}"
  printf "  ${CYAN}%-18s${RESET} %s\n" "OTLP HTTP"    "https://ingest.${domain}/otlp"
  printf "  ${CYAN}%-18s${RESET} %s\n" "Garage S3"    "https://s3.${domain}"
  printf "  ${CYAN}%-18s${RESET} %s\n" "UAR"          "https://uar.${domain}"
  echo
}

cmd_nginx_reload() {
  require_env
  info "Reloading nginx config…"
  cd "${SCRIPT_DIR}" && ${COMPOSE} exec nginx nginx -s reload
  ok "nginx reloaded"
}

cmd_nginx_test() {
  require_env
  info "Testing nginx config…"
  cd "${SCRIPT_DIR}" && ${COMPOSE} exec nginx nginx -t
}

cmd_rules_check() {
  info "Validating alert rule files…"
  local all_ok=true
  for f in "${SCRIPT_DIR}"/configs/rules/*.yml; do
    local name
    name="$(basename "${f}")"
    if python3 - "${f}" <<'PY' 2>/dev/null
import sys, yaml
doc = yaml.safe_load(open(sys.argv[1]))
groups = doc.get("groups", [])
rules  = sum(len(g.get("rules", [])) for g in groups)
print(f"    {len(groups)} group(s), {rules} rule(s)")
PY
    then
      echo -e "  ${GREEN}✔${RESET}  ${name}"
    else
      echo -e "  ${RED}✘${RESET}  ${name}  — YAML parse failed"
      all_ok=false
    fi
  done
  ${all_ok} && ok "All rule files valid" || die "One or more rule files have errors"
}

cmd_validate() {
  info "Validating docker-compose.yml…"
  cd "${SCRIPT_DIR}"
  if ${COMPOSE} config -q 2>/dev/null; then
    ok "docker-compose.yml is valid"
  else
    die "docker-compose.yml has errors"
  fi
  echo
  cmd_rules_check
}

# ── Dispatch ──────────────────────────────────────────────────────────────────
CMD="${1:-help}"
shift || true

[[ "${CMD}" == "help" || "${CMD}" == "--help" || "${CMD}" == "-h" ]] || check_deps

case "${CMD}" in
  help|--help|-h)   usage ;;
  init)             cmd_init ;;
  secrets)          cmd_secrets ;;
  cert)             cmd_cert ;;
  cert-renew)       cmd_cert_renew ;;
  auth)             cmd_auth ;;
  pull)             cmd_pull ;;
  up)               cmd_up ;;
  down)             cmd_down ;;
  restart)          cmd_restart "${@}" ;;
  recreate)         cmd_recreate "${@}" ;;
  clean)            cmd_clean ;;
  reset)            cmd_reset ;;
  status)           cmd_status ;;
  ps)               cmd_ps ;;
  logs)             cmd_logs "${@}" ;;
  exec)             cmd_exec "${@}" ;;
  open)             cmd_open ;;
  urls)             cmd_urls ;;
  nginx-reload)     cmd_nginx_reload ;;
  nginx-test)       cmd_nginx_test ;;
  rules-check)      cmd_rules_check ;;
  validate)         cmd_validate ;;
  *)                die "Unknown command '${CMD}' — run:  ./stack help" ;;
esac
