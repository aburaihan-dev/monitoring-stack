#!/usr/bin/env bash
# stack — monitoring stack CLI
# Usage: ./stack <command> [args]
set -euo pipefail

# ── Colors ────────────────────────────────────────────────────────────────────
if [ -t 1 ]; then
  RED='\033[0;31m' YELLOW='\033[0;33m' GREEN='\033[0;32m'
  CYAN='\033[0;36m' BOLD='\033[1m' DIM='\033[2m' RESET='\033[0m'
else
  RED='' YELLOW='' GREEN='' CYAN='' BOLD='' DIM='' RESET=''
fi

COMPOSE="docker compose"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ENV_FILE="${SCRIPT_DIR}/.env"

# ── Helpers ───────────────────────────────────────────────────────────────────
info()  { echo -e "${CYAN}▶${RESET}  $*"; }
ok()    { echo -e "${GREEN}✔${RESET}  $*"; }
warn()  { echo -e "${YELLOW}⚠${RESET}  $*"; }
die()   { echo -e "${RED}✘${RESET}  $*" >&2; exit 1; }

require_env() {
  [[ -f "${ENV_FILE}" ]] || die ".env not found — run:  ./stack init"
}

env_val() {
  grep -E "^${1}=" "${ENV_FILE}" 2>/dev/null | cut -d= -f2- | tr -d '"'
}

require_svc() {
  [[ -n "${1:-}" ]] || die "service name required  (e.g. ./stack ${CMD} alloy)"
}

# ── Dependency check ──────────────────────────────────────────────────────────
check_deps() {
  local missing=0

  _check_tool() {
    local name="${1}" test_cmd="${2}" install_hint="${3}"
    if ! eval "${test_cmd}" &>/dev/null; then
      warn "Missing: ${BOLD}${name}${RESET}"
      echo -e "  ${DIM}Install: ${install_hint}${RESET}"
      missing=$((missing + 1))
    fi
  }

  # docker (engine)
  _check_tool "docker" \
    "command -v docker" \
    "https://docs.docker.com/engine/install/  |  curl -fsSL https://get.docker.com | sh"

  # docker compose v2 plugin (not standalone compose v1)
  _check_tool "docker compose (v2)" \
    "docker compose version" \
    "Included with Docker Desktop; on Linux: sudo apt install docker-compose-plugin"

  # openssl — secret generation, self-signed certs, cert verification
  _check_tool "openssl" \
    "command -v openssl" \
    "sudo apt install openssl  |  sudo dnf install openssl  |  brew install openssl"

  # python3 — rule linting (validate / rules-check)
  _check_tool "python3" \
    "command -v python3" \
    "sudo apt install python3  |  sudo dnf install python3  |  brew install python3"

  if [[ "${missing}" -gt 0 ]]; then
    echo
    die "${missing} required tool(s) missing — install them then re-run ./stack"
  fi
}

# ── Banner ────────────────────────────────────────────────────────────────────
banner() {
  echo -e "${BOLD}"
  echo "  ╔══════════════════════════════════════════╗"
  echo "  ║   🛰  Monitoring Stack — Mission Control  ║"
  echo "  ╚══════════════════════════════════════════╝"
  echo -e "${RESET}"
}

# ── Help ──────────────────────────────────────────────────────────────────────
usage() {
  banner
  echo -e "${BOLD}Usage:${RESET}  ./stack <command> [service]"
  echo
  echo -e "${BOLD}Setup${RESET}"
  printf "  ${CYAN}%-22s${RESET} %s\n" "init"            "First-run wizard: admin user, secrets, notifications, then up"
  printf "  ${CYAN}%-22s${RESET} %s\n" "secrets"         "Rotate all generated secrets in .env (with restart guidance)"
  printf "  ${CYAN}%-22s${RESET} %s\n" "pull"            "Pull latest images for all services"
  echo
  echo -e "${BOLD}Reverse Proxy${RESET}"
  printf "  ${CYAN}%-22s${RESET} %s\n" "proxy <mode>"    "Set deploy mode: none | http (no SSL) | ssl (existing cert)"
  echo
  echo -e "${BOLD}Object Storage${RESET}"
  printf "  ${CYAN}%-22s${RESET} %s\n" "storage <backend>" "Set backend: garage | seaweedfs"
  echo
  echo -e "${BOLD}Lifecycle${RESET}"
  printf "  ${CYAN}%-22s${RESET} %s\n" "up"              "Start all services (detached)"
  printf "  ${CYAN}%-22s${RESET} %s\n" "down"            "Stop all services (keeps volumes)"
  printf "  ${CYAN}%-22s${RESET} %s\n" "restart <svc>"   "Restart a service"
  printf "  ${CYAN}%-22s${RESET} %s\n" "recreate <svc>"  "Force-recreate a service (picks up config changes)"
  printf "  ${CYAN}%-22s${RESET} %s\n" "clean"           "Stop + remove ALL containers and volumes ${RED}(data loss!)${RESET}"
  printf "  ${CYAN}%-22s${RESET} %s\n" "reset"           "Full wipe + reconfigure: clean, clear certs/secrets, re-run init ${RED}(data loss!)${RESET}"
  echo
  echo -e "${BOLD}Observability${RESET}"
  printf "  ${CYAN}%-22s${RESET} %s\n" "status"          "Show container names, health, and uptime"
  printf "  ${CYAN}%-22s${RESET} %s\n" "ps"              "Compact service list (docker compose ps)"
  printf "  ${CYAN}%-22s${RESET} %s\n" "logs [svc]"      "Tail logs — all services or one"
  printf "  ${CYAN}%-22s${RESET} %s\n" "exec <svc> <cmd>" "Exec a command inside a running container"
  printf "  ${CYAN}%-22s${RESET} %s\n" "open"            "Open Grafana in the default browser"
  printf "  ${CYAN}%-22s${RESET} %s\n" "urls"            "Print all service URLs"
  echo
  echo -e "${BOLD}Validation${RESET}"
  printf "  ${CYAN}%-22s${RESET} %s\n" "validate"        "Validate compose YAML + all rule files"
  printf "  ${CYAN}%-22s${RESET} %s\n" "rules-check"     "Lint alert rule YAML files"
  echo
  echo -e "${DIM}Services: grafana alloy mimir loki tempo alertmanager"
  echo -e "          node-exporter cadvisor blackbox-exporter garage seaweedfs valkey uar nginx${RESET}"
  echo
}

# ── Commands ──────────────────────────────────────────────────────────────────

cmd_init() {
  banner

  if [[ ! -f "${ENV_FILE}" ]]; then
    cp "${SCRIPT_DIR}/.env.example" "${ENV_FILE}"
    ok "Copied .env.example → .env"
    _env_setup
  else
    ok ".env already exists"
    read -rp "  Re-configure existing .env? [y/N]: " reconf
    [[ "${reconf,,}" == "y" ]] && _env_setup
  fi

  _storage_render_config
  cmd_up
}

# ── .env helpers ──────────────────────────────────────────────────────────────

# In-place key replacement using awk (portable, handles special chars in values)
_env_set() {
  local key="${1}" val="${2}" tmp
  tmp="$(mktemp)"
  awk -v k="${key}" -v v="${val}" \
    '$0 ~ "^"k"=" { print k"="v; next } { print }' \
    "${ENV_FILE}" > "${tmp}" && mv "${tmp}" "${ENV_FILE}"
}

_env_setup() {
  echo
  echo -e "${BOLD}  Stack Configuration${RESET}"
  echo

  # Grafana admin user
  local gf_user
  read -rp "  Grafana admin username [admin]: " gf_user
  gf_user="${gf_user:-admin}"
  _env_set GRAFANA_ADMIN_USER "${gf_user}"
  ok "GRAFANA_ADMIN_USER=${gf_user}"

  # Auto-generate secrets
  echo
  read -rp "  Auto-generate all secrets? (Grafana password, Garage + SeaweedFS keys) [Y/n]: " gen
  if [[ "${gen,,}" != "n" ]]; then
    _env_generate_secrets
  else
    echo
    warn "Secrets NOT generated — edit .env manually before starting the stack."
    warn "Keys to change: GRAFANA_ADMIN_PASSWORD, GARAGE_RPC_SECRET,"
    warn "                GARAGE_ADMIN_TOKEN, GARAGE_ACCESS_KEY_ID, GARAGE_SECRET_ACCESS_KEY,"
    warn "                SEAWEEDFS_ACCESS_KEY_ID, SEAWEEDFS_SECRET_ACCESS_KEY"
  fi

  # Object storage backend
  echo
  echo -e "  ${BOLD}Object Storage${RESET}"
  echo -e "  ${DIM}[1] Garage — lightweight, geo-distribution-first (default)"
  echo -e "  [2] SeaweedFS — broader S3 feature coverage${RESET}"
  read -rp "  Choice [1]: " storage_choice
  case "${storage_choice}" in
    2) cmd_storage seaweedfs ;;
    *) cmd_storage garage ;;
  esac

  # Notifications
  echo
  read -rp "  Configure alert notifications now (Slack / email)? [y/N]: " notif
  if [[ "${notif,,}" == "y" ]]; then
    _env_configure_notifications
  else
    info "Skipping — edit .env later to configure Slack/email alerts."
  fi

  # Reverse proxy
  echo
  echo -e "  ${BOLD}Reverse Proxy${RESET}"
  echo -e "  ${DIM}[1] None — direct host ports (default)"
  echo -e "  [2] nginx, no SSL"
  echo -e "  [3] nginx, existing SSL cert${RESET}"
  read -rp "  Choice [1]: " proxy_choice
  case "${proxy_choice}" in
    2) cmd_proxy http ;;
    3) cmd_proxy ssl ;;
    *) cmd_proxy none ;;
  esac
  echo
}

_env_generate_secrets() {
  echo
  info "Generating secrets…"

  local gf_pass garage_rpc garage_token garage_key_id garage_secret sw_key sw_secret
  gf_pass="$(    openssl rand -base64 18 | tr -d '=+/\\'  | head -c 24)"
  garage_rpc="$( openssl rand -hex 32)"
  garage_token="$(openssl rand -hex 16)"
  garage_key_id="GK$(openssl rand -hex 14)"
  garage_secret="$(openssl rand -hex 32)"
  sw_key="SW$(openssl rand -hex 14)"
  sw_secret="$(openssl rand -hex 32)"

  _env_set GRAFANA_ADMIN_PASSWORD   "${gf_pass}"
  _env_set GARAGE_RPC_SECRET        "${garage_rpc}"
  _env_set GARAGE_ADMIN_TOKEN       "${garage_token}"
  _env_set GARAGE_ACCESS_KEY_ID     "${garage_key_id}"
  _env_set GARAGE_SECRET_ACCESS_KEY "${garage_secret}"
  _env_set SEAWEEDFS_ACCESS_KEY_ID     "${sw_key}"
  _env_set SEAWEEDFS_SECRET_ACCESS_KEY "${sw_secret}"

  echo
  echo -e "  ${BOLD}Generated secrets — copy these to a password manager now:${RESET}"
  echo
  printf "  ${CYAN}%-28s${RESET} %s\n" "GRAFANA_ADMIN_PASSWORD"   "${gf_pass}"
  printf "  ${CYAN}%-28s${RESET} %s\n" "GARAGE_RPC_SECRET"        "${garage_rpc}"
  printf "  ${CYAN}%-28s${RESET} %s\n" "GARAGE_ADMIN_TOKEN"       "${garage_token}"
  printf "  ${CYAN}%-28s${RESET} %s\n" "GARAGE_ACCESS_KEY_ID"     "${garage_key_id}"
  printf "  ${CYAN}%-28s${RESET} %s\n" "GARAGE_SECRET_ACCESS_KEY" "${garage_secret}"
  printf "  ${CYAN}%-28s${RESET} %s\n" "SEAWEEDFS_ACCESS_KEY_ID"     "${sw_key}"
  printf "  ${CYAN}%-28s${RESET} %s\n" "SEAWEEDFS_SECRET_ACCESS_KEY" "${sw_secret}"
  echo
  warn ".env is gitignored — back it up securely and never commit it."
}

_env_configure_notifications() {
  # Slack
  echo
  echo -e "  ${BOLD}Slack${RESET}"
  local slack_url slack_channel
  read -rp "  Webhook URL (blank to skip): " slack_url
  if [[ -n "${slack_url}" ]]; then
    read -rp "  Channel [#monitoring-alerts]: " slack_channel
    slack_channel="${slack_channel:-#monitoring-alerts}"
    _env_set SLACK_WEBHOOK_URL "${slack_url}"
    _env_set SLACK_CHANNEL     "${slack_channel}"
    ok "Slack configured (${slack_channel})"
  fi

  # Email
  echo
  echo -e "  ${BOLD}Email${RESET}"
  local from_addr to_addr smtp_host smtp_user smtp_pass
  read -rp "  From address (blank to skip): " from_addr
  if [[ -n "${from_addr}" ]]; then
    read -rp "  To address:        " to_addr
    read -rp "  SMTP host:port:    " smtp_host
    read -rp "  SMTP username:     " smtp_user
    read -rsp "  SMTP password:     " smtp_pass; echo
    _env_set ALERT_EMAIL_FROM "${from_addr}"
    _env_set ALERT_EMAIL_TO   "${to_addr}"
    _env_set SMTP_HOST        "${smtp_host}"
    _env_set SMTP_USERNAME    "${smtp_user}"
    _env_set SMTP_PASSWORD    "${smtp_pass}"
    ok "Email configured (${from_addr} → ${to_addr})"
  fi
}

cmd_secrets() {
  require_env
  echo
  echo -e "${BOLD}  Secret Rotation${RESET}"
  echo -e "  ${DIM}This replaces Grafana password and all Garage + SeaweedFS keys in .env.${RESET}"
  echo -e "  ${YELLOW}⚠${RESET}  After rotation you must re-run storage-init and restart the stack:"
  echo -e "  ${DIM}./stack recreate storage-init && ./stack recreate alloy${RESET}"
  echo
  read -rp "  Continue? [y/N]: " confirm
  [[ "${confirm,,}" == "y" ]] || { info "Aborted."; exit 0; }
  _env_generate_secrets
  # Re-sync the generic OBJECT_STORAGE_* copies to the freshly rotated keys
  # of whichever backend is currently active, and re-render its config file.
  cmd_storage "$(env_val OBJECT_STORAGE)"
  warn "Restart required — run:  ./stack recreate garage seaweedfs storage-init alloy"
}

cmd_pull() {
  require_env
  info "Pulling latest images…"
  cd "${SCRIPT_DIR}" && ${COMPOSE} pull
}

# Render garage.toml from .env values — called before any stack start
# Avoids mounting a shell script into a shell-less garage container.
_garage_render_config() {
  require_env
  local out="${SCRIPT_DIR}/configs/garage/garage.toml"
  local rpc_secret admin_token
  rpc_secret="$(env_val GARAGE_RPC_SECRET)"
  admin_token="$(env_val GARAGE_ADMIN_TOKEN)"
  [[ -n "${rpc_secret}"  ]] || die "GARAGE_RPC_SECRET not set in .env — run: ./stack init"
  [[ -n "${admin_token}" ]] || die "GARAGE_ADMIN_TOKEN not set in .env — run: ./stack init"

  mkdir -p "${SCRIPT_DIR}/configs/garage"
  cat > "${out}" <<TOML
metadata_dir = "/var/lib/garage/meta"
data_dir     = "/var/lib/garage/data"
db_engine    = "sqlite"

# Single-node setup — no replication. Change to 2 or 3 for HA cluster.
replication_factor = 1

# Use loopback for single-node so the garage CLI can reach itself inside the
# container without relying on hostname resolution (matches reference setup).
rpc_bind_addr   = "0.0.0.0:3901"
rpc_public_addr = "127.0.0.1:3901"
rpc_secret      = "${rpc_secret}"

[s3_api]
s3_region     = "garage"
api_bind_addr = "0.0.0.0:3900"
root_domain   = ".s3.garage"

[s3_web]
bind_addr   = "0.0.0.0:3902"
root_domain = ".web.garage"
index       = "index.html"

[admin]
api_bind_addr = "0.0.0.0:3903"
admin_token   = "${admin_token}"
TOML
  ok "configs/garage/garage.toml rendered"
}

# Render the SeaweedFS S3 gateway identity file from .env values.
_seaweedfs_render_config() {
  require_env
  local out="${SCRIPT_DIR}/configs/seaweedfs/s3.json"
  local access_key secret_key
  access_key="$(env_val SEAWEEDFS_ACCESS_KEY_ID)"
  secret_key="$(env_val SEAWEEDFS_SECRET_ACCESS_KEY)"
  [[ -n "${access_key}" ]] || die "SEAWEEDFS_ACCESS_KEY_ID not set in .env — run: ./stack init"
  [[ -n "${secret_key}" ]] || die "SEAWEEDFS_SECRET_ACCESS_KEY not set in .env — run: ./stack init"

  mkdir -p "${SCRIPT_DIR}/configs/seaweedfs"
  cat > "${out}" <<JSON
{
  "identities": [
    {
      "name": "monitoring-stack",
      "credentials": [
        {"accessKey": "${access_key}", "secretKey": "${secret_key}"}
      ],
      "actions": ["Admin", "Read", "Write"]
    }
  ]
}
JSON
  ok "configs/seaweedfs/s3.json rendered"
}

# Render whichever backend's config is currently active — called before any
# stack start, mirroring the old unconditional _garage_render_config call.
_storage_render_config() {
  case "$(env_val OBJECT_STORAGE)" in
    seaweedfs) _seaweedfs_render_config ;;
    *)         _garage_render_config ;;
  esac
}

# Recompute COMPOSE_PROFILES from the currently active storage backend and
# proxy mode — this is what actually turns garage/seaweedfs/nginx on or off.
_sync_profiles() {
  local storage proxy profiles
  storage="$(env_val OBJECT_STORAGE)"; storage="${storage:-garage}"
  proxy="$(env_val PROXY_MODE)"; proxy="${proxy:-none}"
  profiles="${storage}"
  [[ "${proxy}" != "none" ]] && profiles="${profiles},proxy"
  _env_set COMPOSE_PROFILES "${profiles}"
}

cmd_storage() {
  require_env
  local mode="${1:-}"
  case "${mode}" in
    garage|seaweedfs) ;;
    *) die "Usage: ./stack storage <garage|seaweedfs>" ;;
  esac

  _env_set OBJECT_STORAGE "${mode}"
  if [[ "${mode}" == "garage" ]]; then
    _env_set OBJECT_STORAGE_ENDPOINT          "garage:3900"
    _env_set OBJECT_STORAGE_ACCESS_KEY_ID     "$(env_val GARAGE_ACCESS_KEY_ID)"
    _env_set OBJECT_STORAGE_SECRET_ACCESS_KEY "$(env_val GARAGE_SECRET_ACCESS_KEY)"
    _env_set OBJECT_STORAGE_REGION            "garage"
    _garage_render_config
  else
    _env_set OBJECT_STORAGE_ENDPOINT          "seaweedfs:8333"
    _env_set OBJECT_STORAGE_ACCESS_KEY_ID     "$(env_val SEAWEEDFS_ACCESS_KEY_ID)"
    _env_set OBJECT_STORAGE_SECRET_ACCESS_KEY "$(env_val SEAWEEDFS_SECRET_ACCESS_KEY)"
    _env_set OBJECT_STORAGE_REGION            "us-east-1"
    _seaweedfs_render_config
  fi

  _sync_profiles
  ok "Object storage: ${mode}"
  info "Run  ./stack up  to apply — data in the other backend is left untouched but unused"
}

# Copy the selected nginx template into place — called by cmd_proxy.
_nginx_render_config() {
  local mode="${1}"
  mkdir -p "${SCRIPT_DIR}/configs/nginx/ssl"
  cp "${SCRIPT_DIR}/configs/nginx/nginx-${mode}.conf" "${SCRIPT_DIR}/configs/nginx/nginx.conf"
}

cmd_proxy() {
  require_env
  local mode="${1:-}"
  case "${mode}" in
    none|http|ssl) ;;
    *) die "Usage: ./stack proxy <none|http|ssl>" ;;
  esac

  if [[ "${mode}" == "ssl" ]]; then
    [[ -f "${SCRIPT_DIR}/configs/nginx/ssl/fullchain.pem" && -f "${SCRIPT_DIR}/configs/nginx/ssl/privkey.pem" ]] \
      || die "Missing configs/nginx/ssl/fullchain.pem + privkey.pem — place your existing cert there first"
  fi

  _env_set PROXY_MODE "${mode}"
  if [[ "${mode}" == "none" ]]; then
    ok "Proxy mode: none — Grafana stays on host port 3000"
  else
    _nginx_render_config "${mode}"
    local http_port https_port
    http_port="$(env_val PROXY_HTTP_PORT)"; http_port="${http_port:-80}"
    https_port="$(env_val PROXY_HTTPS_PORT)"; https_port="${https_port:-443}"
    if [[ "${mode}" == "ssl" ]]; then
      ok "Proxy mode: ssl — nginx will front Grafana on :${https_port} (redirect from :${http_port})"
    else
      ok "Proxy mode: http — nginx will front Grafana on :${http_port}"
    fi
  fi
  _sync_profiles
  info "Run  ./stack up  (or  ./stack recreate nginx)  to apply"
}

cmd_up() {
  require_env
  _storage_render_config
  info "Starting all services…"
  cd "${SCRIPT_DIR}" && ${COMPOSE} up -d
  echo
  cmd_status
}

cmd_down() {
  require_env
  info "Stopping all services…"
  cd "${SCRIPT_DIR}" && ${COMPOSE} down
  ok "Stack stopped (volumes retained)"
}

cmd_restart() {
  require_env
  require_svc "${1:-}"
  info "Restarting ${1}…"
  cd "${SCRIPT_DIR}" && ${COMPOSE} restart "${1}"
  ok "${1} restarted"
}

cmd_recreate() {
  require_env
  require_svc "${1:-}"
  info "Force-recreating ${1} (picks up config file changes)…"
  cd "${SCRIPT_DIR}" && ${COMPOSE} up -d --force-recreate --no-deps "${1}"
  ok "${1} recreated"
}

cmd_clean() {
  warn "This will destroy ALL containers and volumes — data will be lost!"
  read -rp "  Type 'yes' to confirm: " confirm
  [[ "${confirm}" == "yes" ]] || { info "Aborted."; exit 0; }
  cd "${SCRIPT_DIR}" && ${COMPOSE} --profile "*" down -v --remove-orphans
  ok "Stack and all volumes removed"
  echo -e "  ${DIM}Tip: run  ./stack reset  to also wipe certs/secrets and re-run the setup wizard${RESET}"
}

cmd_reset() {
  echo
  echo -e "${RED}${BOLD}  !! FULL RESET — ALL DATA AND CONFIGURATION WILL BE DESTROYED !!${RESET}"
  echo
  echo -e "  This will:"
  echo -e "  ${DIM}  • Stop all containers and delete all volumes (Loki/Mimir/Tempo/Garage/SeaweedFS data)${RESET}"
  echo -e "  ${DIM}  • Remove configs/garage/garage.toml, configs/seaweedfs/s3.json, configs/nginx/nginx.conf${RESET}"
  echo -e "  ${DIM}  • Optionally wipe .env and generate fresh secrets${RESET}"
  echo -e "  ${DIM}  • Re-run the full setup wizard (admin, secrets, notifications, start)${RESET}"
  echo
  read -rp "  Type 'RESET' (uppercase) to confirm: " confirm
  [[ "${confirm}" == "RESET" ]] || { info "Aborted."; exit 0; }

  echo
  info "1/3  Tearing down containers and volumes…"
  cd "${SCRIPT_DIR}" && ${COMPOSE} --profile "*" down -v --remove-orphans 2>/dev/null || true
  ok "Containers and volumes removed"

  info "2/3  Removing generated config files…"
  rm -f  "${SCRIPT_DIR}/configs/garage/garage.toml"
  rm -f  "${SCRIPT_DIR}/configs/seaweedfs/s3.json"
  rm -f  "${SCRIPT_DIR}/configs/nginx/nginx.conf"
  ok "Generated configs cleared (garage.toml, s3.json, nginx.conf)"

  echo
  read -rp "  Wipe .env and start with fresh secrets? [Y/n]: " wipe_env
  if [[ "${wipe_env,,}" != "n" ]]; then
    rm -f "${ENV_FILE}"
    ok ".env removed — setup wizard will create a fresh one"
  else
    ok ".env kept — existing domain and secrets will be reused"
  fi

  echo
  info "3/3  Launching setup wizard…"
  echo
  cmd_init
}

cmd_status() {
  require_env
  echo -e "\n${BOLD}  Container Health${RESET}"
  docker ps \
    --filter "label=logging=alloy" \
    --format "  {{printf \"%-28s\" .Names}} {{.Status}}" \
    | sed -E \
        -e "s/(Up.*healthy)/${GREEN}\1${RESET}/" \
        -e "s/(Up [^(]*)$/${GREEN}\1${RESET}/" \
        -e "s/(unhealthy|Exited|Restarting)/${RED}\1${RESET}/" \
        -e "s/(starting|health: starting)/${YELLOW}\1${RESET}/"
  echo
}

cmd_ps() {
  require_env
  cd "${SCRIPT_DIR}" && ${COMPOSE} ps
}

cmd_logs() {
  require_env
  cd "${SCRIPT_DIR}" && ${COMPOSE} logs -f --tail=100 "${@}"
}

cmd_exec() {
  require_env
  require_svc "${1:-}"
  shift
  [[ $# -gt 0 ]] || die "command required  (e.g. ./stack exec alloy /bin/sh)"
  cd "${SCRIPT_DIR}" && ${COMPOSE} exec "${@}"
}

cmd_open() {
  require_env
  local url="http://localhost:3000"
  info "Opening ${url}…"
  xdg-open "${url}" 2>/dev/null || open "${url}" 2>/dev/null || \
    warn "Could not open browser automatically — visit: ${url}"
}

cmd_urls() {
  echo
  echo -e "${BOLD}  Service URLs${RESET}"
  local mode http_port https_port
  mode="$(env_val PROXY_MODE)"
  http_port="$(env_val PROXY_HTTP_PORT)"; http_port="${http_port:-80}"
  https_port="$(env_val PROXY_HTTPS_PORT)"; https_port="${https_port:-443}"
  if [[ "${mode}" == "http" ]]; then
    printf "  ${CYAN}%-18s${RESET} %s\n" "Grafana (proxy)" "http://localhost:${http_port}"
  elif [[ "${mode}" == "ssl" ]]; then
    printf "  ${CYAN}%-18s${RESET} %s\n" "Grafana (proxy)" "https://localhost:${https_port}"
  fi
  printf "  ${CYAN}%-18s${RESET} %s\n" "Grafana"      "http://localhost:3000"
  printf "  ${CYAN}%-18s${RESET} %s\n" "Alertmanager" "http://localhost:9093"
  printf "  ${CYAN}%-18s${RESET} %s\n" "Alloy UI"     "http://localhost:12345"
  printf "  ${CYAN}%-18s${RESET} %s\n" "OTLP gRPC"    "localhost:4317"
  printf "  ${CYAN}%-18s${RESET} %s\n" "OTLP HTTP"    "http://localhost:4318"
  printf "  ${CYAN}%-18s${RESET} %s\n" "Loki Push"    "http://localhost:3500/loki/api/v1/push"
  echo
}

cmd_rules_check() {
  info "Validating alert rule files…"
  local all_ok=true
  for f in "${SCRIPT_DIR}"/configs/rules/*.yml; do
    local name
    name="$(basename "${f}")"
    if python3 - "${f}" <<'PY' 2>/dev/null
import sys, yaml
doc = yaml.safe_load(open(sys.argv[1]))
groups = doc.get("groups", [])
rules  = sum(len(g.get("rules", [])) for g in groups)
print(f"    {len(groups)} group(s), {rules} rule(s)")
PY
    then
      echo -e "  ${GREEN}✔${RESET}  ${name}"
    else
      echo -e "  ${RED}✘${RESET}  ${name}  — YAML parse failed"
      all_ok=false
    fi
  done
  ${all_ok} && ok "All rule files valid" || die "One or more rule files have errors"
}

cmd_validate() {
  info "Validating docker-compose.yml…"
  cd "${SCRIPT_DIR}"
  if ${COMPOSE} config -q 2>/dev/null; then
    ok "docker-compose.yml is valid"
  else
    die "docker-compose.yml has errors"
  fi
  echo
  cmd_rules_check
}

# ── Dispatch ──────────────────────────────────────────────────────────────────
CMD="${1:-help}"
shift || true

[[ "${CMD}" == "help" || "${CMD}" == "--help" || "${CMD}" == "-h" ]] || check_deps

case "${CMD}" in
  help|--help|-h)   usage ;;
  init)             cmd_init ;;
  secrets)          cmd_secrets ;;
  pull)             cmd_pull ;;
  proxy)            cmd_proxy "${@}" ;;
  storage)          cmd_storage "${@}" ;;
  up)               cmd_up ;;
  down)             cmd_down ;;
  restart)          cmd_restart "${@}" ;;
  recreate)         cmd_recreate "${@}" ;;
  clean)            cmd_clean ;;
  reset)            cmd_reset ;;
  status)           cmd_status ;;
  ps)               cmd_ps ;;
  logs)             cmd_logs "${@}" ;;
  exec)             cmd_exec "${@}" ;;
  open)             cmd_open ;;
  urls)             cmd_urls ;;
  rules-check)      cmd_rules_check ;;
  validate)         cmd_validate ;;
  *)                die "Unknown command '${CMD}' — run:  ./stack help" ;;
esac
